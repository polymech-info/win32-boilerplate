{
  "name": "@polymech/xblox",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app:dev": "vite --config vite.config.ts",
    "dev:demo": "vite --open /chat/demo",
    "dev:embed": "webpack serve --config webpack.config.cjs --mode development",
    "build": "tsc --noEmit && vite build",
    "build:embed": "webpack --config webpack.config.cjs --mode production",
    "build:all": "npm run build && npm run build:embed",
    "build:analyze": "tsc --noEmit && vite build && start dist/stats.html",
    "preview": "vite preview",
    "serve": "npx serve dist -s"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.114.3",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.544.0",
    "marked": "^15.0.6",
    "preact": "^10.29.1",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^7.1.2",
    "esbuild": "^0.27.7",
    "esbuild-loader": "^4.4.3",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "style-loader": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
