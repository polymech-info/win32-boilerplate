// ── French ────────────────────────────────────────────────────────────────────
LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

IDW_MAIN MENU
BEGIN
    POPUP "&Fichier"
    BEGIN
        MENUITEM "&Ajouter des fichiers…",       IDM_ADD_FILES
        MENUITEM "Ajouter un &dossier…",      IDM_ADD_FOLDER
        POPUP "Fichiers &récents"
        BEGIN
            MENUITEM "(aucun)", IDM_RECENT_MENU_DUMMY_FILE, GRAYED INACTIVE
        END
