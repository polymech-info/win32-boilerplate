#endif
        MENUITEM "E&xplorateur de fichiers", IDC_CMD_VIEW_FILETREE
        MENUITEM "Aper&çu",             IDC_CMD_VIEW_VIEWER_PANEL
#if defined(FEATURE_CONSOLE)
