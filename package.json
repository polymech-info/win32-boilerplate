{
  "name": "media-cpp",
  "version": "0.1.0",
  "type": "module",
  "description": "media-img — image resize CLI, REST server, and JSON-line IPC (C++).",
  "bin": {
    "pm-cmake": "scripts/cmake.mjs"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "daemon": "pm-image daemon run",
    "features": "node scripts/export-features.mjs --preset release",
    "features:dev": "node scripts/export-features.mjs --preset dev",
    "features:store-msi": "node scripts/export-features.mjs --preset store-msi-release",
    "features:linux": "node scripts/export-features.mjs --preset release-linux",
    "features:linux:gui": "node scripts/export-features.mjs --preset release-linux -DPM_BUILD_LINUX_GUI=ON -DLINUX_USE_LIBPANEL=ON",
    "features:macos": "node scripts/export-features.mjs --preset release-macos -DCMAKE_EXE_LINKER_FLAGS=-L/opt/homebrew/lib",
    "configure": "node scripts/platform-build.mjs configure",
    "build:cli": "node scripts/platform-build.mjs build:cli",
    "build:ui": "node scripts/platform-build.mjs build:ui",
    "configure:osx": "node scripts/platform-build.mjs configure --remote osx",
    "configure:linux": "node scripts/platform-build.mjs configure --remote linux",
    "build:cli:osx": "node scripts/platform-build.mjs build:cli --remote osx",
    "build:cli:linux": "node scripts/platform-build.mjs build:cli --remote linux",
    "build:ui:osx": "node scripts/platform-build.mjs build:ui  --remote osx",
    "build:remote": "node scripts/platform-build.mjs build:cli --remote all",
    "--- configure ---": "echo ''",
    "config": "npm run features:dev",
    "config:release": "npm run features",
    "config:clang-tidy": "node scripts/cmake.mjs --preset clang-tidy",
    "config:msvc-asan": "node scripts/cmake.mjs --preset msvc-asan",
    "configure:cpp": "npm run features",
    "configure:cpp:macos": "npm run features:macos",
    "--- build: web ---": "echo ''",
    "build:chat-next:embed": "npm --prefix apps/chat-next install --silent --no-fund --no-audit && npm --prefix apps/chat-next run build:embed",
    "build:viewer-next:embed": "npm --prefix apps/viewer-next install --silent --no-fund --no-audit && npm --prefix apps/viewer-next run build:embed",
    "build:settings:embed": "npm --prefix apps/settings install --silent --no-fund --no-audit && npm --prefix apps/settings run build:embed",
    "build:shell:embed": "npm --prefix apps/shell install --silent --no-fund --no-audit && npm --prefix apps/shell run build:embed",
    "build:home:embed": "npm --prefix apps/home install --silent --no-fund --no-audit && npm --prefix apps/home run build:embed",
    "build:xblox:embed": "npm --prefix apps/xblox install --silent --no-fund --no-audit && npm --prefix apps/xblox run build:embed",
    "buildf:web": "npm run build:chat-next:embed && npm run build:settings:embed && npm run build:viewer-next:embed && npm run build:shell:embed && npm run build:home:embed && npm run build:xblox:embed",
    "--- build: windows ---": "echo ''",
    "build:cpp": "npm run features && node scripts/cmake.mjs --build --preset release --config Release",
    "build:all": "node scripts/platform-build.mjs build:all",
    "build:cpp:cli": "npm run features && node scripts/cmake.mjs --build --preset release --config Release --target pm-image-cli",
    "buildf": "npm run buildf:web && npm run build:cpp",
    "build": "npm run buildf:web && npm run features",
    "build:release": "npm run build",
    "build:only": "npm run build:cpp",
    "build:retail": "npm run buildf:web && npm run features && node scripts/cmake.mjs --build --preset release --config Release",
    "build:lib": "npm run features && node scripts/cmake.mjs --build --preset release --config Release --target pm-media",
    "build:lib:shared": "node scripts/export-features.mjs --preset release -DPOLYMECH_MEDIA_SHARED=ON && node scripts/cmake.mjs --build --preset release --config Release --target pm-media",
    "build:win32-mini": "node scripts/cmake.mjs --preset win32-mini -S apps/win32-mini && node scripts/cmake.mjs --build build/win32-mini --config Release",
    "--- build: linux ---": "echo ''",
    "build:linux": "npm run features:linux && node scripts/cmake.mjs --build --preset release-linux",
    "build:linux:configure": "npm run features:linux",
    "build:linux:cpp": "npm run features:linux && node scripts/cmake.mjs --build --preset release-linux",
    "package:linux": "npm run features:linux && node scripts/cmake.mjs --build --preset release-linux --target package",
    "build:linux:deb": "npm run features:linux && node scripts/cmake.mjs --build --preset release-linux && node scripts/make-deb.mjs",
    "build:linux:deb:only": "node scripts/make-deb.mjs",
    "build:linux:clean": "node scripts/cmake.mjs -E rm -rf $HOME/.pm-media-build/linux-release",
    "build:ui:linux": "npm run build:gui:linux",
    "build:gui:linux": "npm run features:linux:gui && node scripts/cmake.mjs --build --preset release-linux --target pm-image-gui",
    "--- build: macos ---": "echo ''",
    "build:osx": "npm run buildf:web && npm --prefix osx run build:osx",
    "build:pixlwiz": "node scripts/export-features.mjs --preset release-macos -DPM_BUILD_CODEEDIT=ON && node scripts/cmake.mjs --build --preset release-macos --target pm-codeedit",
    "build:pixlwiz:incremental": "npm --prefix osx run build:pixlwiz",
    "build:codeedit": "npm run build:pixlwiz",
    "build:codeeditor": "npm run build:pixlwiz",
    "build:cpp:macos": "npm run features:macos && node scripts/cmake.mjs --build --preset release-macos --config Release --target pm-image",
    "build:test-app": "node osx/scripts/run-ssh.cjs -- bash osx/pm-image/build_test_app.sh",
    "open:pixlwiz-xcode": "bash osx/CodeEdit/launch-xcode-pixelwiz.sh",
    "strip:swiftlint-spm": "bash osx/CodeEdit/strip-swiftlint-spm-checkouts.sh",
    "--- log: macos ---": "echo ''",
    "log:pixlwiz": "log stream --predicate 'process == \"PixelWiz\"' --level info",
    "log:codeedit": "npm run log:pixlwiz",
    "log:pm-image:subsystem": "log stream --predicate 'subsystem == \"com.polymech.pm-image\"' --level debug --style compact",
    "log:pm-image:stream-tee": "log stream --predicate 'process == \"PixelWiz\"' --level debug --style compact | tee pm-image-oslog.txt",
    "log:pm-image:osx-last": "log show --last 10m --predicate \"process == \\\"PixelWiz\\\"\" --style compact > osx-last.txt",
    "--- static analysis ---": "echo ''",
    "clang-tidy": "npm run buildf:web && node scripts/cmake.mjs --preset clang-tidy && node scripts/cmake.mjs --build --preset clang-tidy --config Debug",
    "clang-tidy-report": "npm run clang-tidy 2>&1 | Tee-Object -FilePath clang-tidy.log",
    "msvc:address-sanitizer": "npm run buildf:web && node scripts/cmake.mjs --preset msvc-asan && node scripts/cmake.mjs --build --preset msvc-asan --config Debug",
    "--- signing ---": "echo ''",
    "build:sign": "powershell -ExecutionPolicy Bypass -File scripts/codesign-dev.ps1",
    "build:sign:cert": "powershell -ExecutionPolicy Bypass -File scripts/codesign-dev.ps1 -CertOnly",
    "--- installer ---": "echo ''",
    "docs:html": "node scripts/md-to-html.mjs",
    "docs:commands": "node scripts/cli-llm.mjs",
    "docs:xblox": "node scripts/xblox-llm.mjs",
    "docs:tools": "node scripts/tools-llm.mjs",
    "docs:skills": "node scripts/skills-llm.mjs",
    "docs:llm": "node scripts/docs-llm.mjs",
    "info:commands": "node scripts/info-skills.mjs commands",
    "info:xblox": "node scripts/info-skills.mjs xblox",
    "info": "node scripts/info-skills.mjs",
    "postbuild:cpp": "npm run info",
    "postbuild:cpp:cli": "npm run info",
    "postbuild:retail": "npm run info",
    "docs:installer": "npm run docs:llm && npm run docs:html",
    "setup:vc-redist": "powershell -ExecutionPolicy Bypass -File scripts/fetch-vc-redist.ps1",
    "build:installer:bitmaps": "node scripts/make-installer-bitmaps.mjs",
    "build:installer": "npm run build:retail && npm run docs:installer && node scripts/refresh-installer-branding.mjs && node scripts/make-installer-bitmaps.mjs && powershell -ExecutionPolicy Bypass -File scripts/fetch-vc-redist.ps1 && makensis -V2 dist\\installer\\installer.nsi",
    "build:installer:msi": "node scripts/build-installer-msi.mjs",
    "test:installer": "dist\\pm-images-setup.exe /S /D=%CD%\\dist-installer-test",
    "--- vips ---": "echo ''",
    "setup:vips": "powershell -ExecutionPolicy Bypass -File scripts/fetch-vips-windows.ps1",
    "vips:build-from-source:win": "powershell -ExecutionPolicy Bypass -File scripts/build-libvips-from-source.ps1",
    "vips:build-static:wsl": "wsl -e bash scripts/build-libvips-static-wsl.sh",
    "--- test ---": "echo ''",
    "test:all": "node scripts/test-all.mjs",
    "test:replicate": "node tests/orchestrator/test-replicate.mjs",
    "test:pixlwiz": "node tests/orchestrator/test-pixlwiz.mjs",
    "test:mcp": "node tests/orchestrator/test-mcp.mjs",
    "test:media": "node tests/orchestrator/test-media.mjs",
    "test:media:templates": "node tests/orchestrator/test-media.mjs --templates-only",
    "test:media:glob": "node tests/orchestrator/test-media.mjs --glob-batch-only",
    "test:media:glob:raw": "node tests/orchestrator/test-media.mjs --glob-batch-only --glob-raw",
    "test:media:input-selection": "node tests/orchestrator/test-media.mjs --input-selection-only",
    "test:media:resize": "node tests/orchestrator/test-media.mjs --resize-only",
    "test:media:compress": "node tests/orchestrator/test-media.mjs --compress-only",
    "test:media:meta": "node tests/orchestrator/test-media.mjs --meta-only",
    "test:media:find": "node tests/orchestrator/test-media.mjs --find-only",
    "test:media:rest": "node tests/orchestrator/test-media.mjs --rest-only",
    "test:media:multipart": "node tests/orchestrator/test-media.mjs --multipart-only",
    "test:media:ipc": "node tests/orchestrator/test-media.mjs --ipc-only",
    "test:media:url": "node tests/orchestrator/test-media.mjs --url-only",
    "test:media:api": "node tests/orchestrator/test-media.mjs --api-only",
    "test:media:chat": "node tests/orchestrator/test-media.mjs --chat-only",
    "test:media:queue": "node tests/orchestrator/test-media.mjs --queue-only",
    "test:media:llm": "node tests/orchestrator/test-media.mjs --llm-only",
    "test:llm:security": "node tests/orchestrator/test-media.mjs --llm-security-only",
    "test:llm:tools": "node tests/orchestrator/test-media.mjs --llm-tools-only",
    "test:skills:basics": "node tests/orchestrator/test-skills.mjs",
    "test:skills:nest:1": "npm run test:skills:basics",
    "test:skills:nest": "npm run test:skills:nest:1",
    "test:search": "node tests/orchestrator/test-search.mjs",
    "test:duplicates": "node tests/orchestrator/test-media-duplicate.mjs",
    "test:duplicates:size-name": "node tests/orchestrator/test-media-duplicate.mjs --size-name",
    "test:duplicates:fingerprint": "node tests/orchestrator/test-media-duplicate.mjs --fingerprint",
    "test:duplicates:meta": "node tests/orchestrator/test-media-duplicate.mjs --meta",
    "test:commands": "node tests/orchestrator/test-commands.mjs",
    "test:commands:real": "node tests/orchestrator/test-commands.mjs --real-ai",
    "test:xblox": "node tests/orchestrator/test-xblox.mjs",
    "test:xblox:expressions": "node tests/orchestrator/test-xblox.mjs --expressions-only",
    "test:xblox:context": "node tests/orchestrator/test-xblox.mjs --context-only",
    "test:xblox:network": "node tests/orchestrator/test-xblox.mjs --network-only",
    "test:modbus": "node tests/orchestrator/test-modbus.js",
    "test:app-use": "node tests/orchestrator/test-app-use.mjs",
    "test:app-use:inspect": "node tests/orchestrator/test-app-use.mjs --inspect-only",
    "test:app-use:notepad": "node tests/orchestrator/test-app-use.mjs --notepad-only",
    "test:app-use:chrome": "node tests/orchestrator/test-app-use.mjs --chrome-only",
    "test:app-use:calculator": "node tests/orchestrator/test-app-use.mjs --calculator-only",
    "test:app-use:terminal": "node tests/orchestrator/test-app-use.mjs --terminal-only",
    "test:app-use:llm-agent": "node tests/orchestrator/test-app-use.mjs --llm-agent-only",
    "test:app-use:agent:notepad": "node tests/orchestrator/test-app-use.mjs --llm-agent-only",
    "test:app-use:agent:chrome": "node tests/orchestrator/test-app-use.mjs --llm-chrome-only",
    "test:app-use:agent:calculator": "node tests/orchestrator/test-app-use.mjs --llm-calculator-only",
    "test:app-use:paint:tictactoe": "node tests/orchestrator/test-app-use.mjs --paint-tictactoe-only",
    "test:app-use:agent:paint:tictactoe": "node tests/orchestrator/test-app-use.mjs --llm-paint-tictactoe-only",
    "test:app-use:agent:wordpad:tictactoe:battle": "node tests/orchestrator/test-app-use.mjs --llm-wordpad-tictactoe-battle-only",
    "test:app-use:agent:paint:tictactoe:battle": "node tests/orchestrator/test-app-use.mjs --llm-paint-tictactoe-battle-only",
    "test:app-use:agent:paint:tictactoe:a2a": "node tests/orchestrator/test-app-use.mjs --llm-paint-tictactoe-a2a-only",
    "test:app-use:agent:paint:tictactoe:a2a:4x4": "node tests/orchestrator/test-app-use.mjs --llm-paint-tictactoe-a2a-4x4-only",
    "test:app-use:agent:memory:persist": "node tests/orchestrator/test-app-use.mjs --llm-memory-persist-only",
    "test:app-use:agent:paint:tictactoe:human-vs-agent": "node tests/orchestrator/test-app-use.mjs --llm-paint-tictactoe-h2a-4x4-only",
    "play:paint:tictactoe": "node tests/orchestrator/play-paint-tictactoe.mjs",
    "play:agent:loop": "node tests/orchestrator/play-agent-loop.mjs",
    "test:app-use:libreoffice": "node tests/orchestrator/test-app-use.mjs --libreoffice-only",
    "test:piano": "node tests/orchestrator/test-app-use.mjs --piano-only",
    "test:tools:run": "node tests/orchestrator/test-media.mjs --run-tool-only",
    "test:tools:run:cli-app": "node tests/orchestrator/test-run-tool-agent.mjs",
    "test:settings": "node tests/orchestrator/test-media.mjs --settings-only",
    "test:trial-protection": "node tests/trial-protection.mjs",
    "test:license-smoke": "node tests/license-smoke.mjs",
    "test:license-dat": "npm --prefix apps/license-server test",
    "test:zitadel": "node tests/orchestrator/zitadel-login.mjs",
    "test:service": "node tests/orchestrator/test-service.mjs",
    "test:service:upload": "node tests/orchestrator/test-service.mjs --upload-only",
    "test:service:posts": "node tests/orchestrator/test-service-posts.mjs",
    "--- dev shortcuts ---": "echo ''",
    "run": "node scripts/invoke-media-img.mjs --no-gui --help",
    "resize": "node scripts/invoke-media-img.mjs --no-gui resize",
    "compress": "node scripts/invoke-media-img.mjs --no-gui compress",
    "compress:mozjpeg": "node scripts/invoke-media-img.mjs --no-gui compress --compressor=mozjpeg",
    "compress:png": "node scripts/invoke-media-img.mjs --no-gui compress --compressor=png",
    "meta": "node scripts/invoke-media-img.mjs --no-gui meta",
    "meta:dry": "node scripts/invoke-media-img.mjs --no-gui meta --dry-run",
    "serve": "node scripts/invoke-media-img.mjs --no-gui serve --help",
    "ipc": "node scripts/invoke-media-img.mjs --no-gui ipc --help",
    "llm:help": "node scripts/invoke-media-img.mjs --no-gui llm --help",
    "provider:models:openrouter": "node scripts/invoke-media-img.mjs --no-gui provider models list --provider openrouter",
    "--- misc ---": "echo ''",
    "clean": "node scripts/cmake.mjs -E rm -rf build dist",
    "rebuild": "npm run clean && npm run build",
    "release": "npm run build:release && npm run build:installer",
    "generate:assets": "node tests/assets/build-fixtures.mjs",
    "license-server": "npm --prefix apps/license-server run start",
    "register-explorer": "pm-image register-explorer",
    "unregister-explorer": "pm-image register-explorer --unregister"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.2",
    "marked-highlight": "^2.2.4",
    "sharp": "^0.34.5"
  }
}
