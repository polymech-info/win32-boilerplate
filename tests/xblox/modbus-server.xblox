{
  "version": 1,
  "comment": "Modbus TCP server sample. Start this in one terminal, then run tests/xblox/modbus-client.xblox in another. It stops after 3 requests or 30s. Run: pm-image-cli xblox run --json --no-wait --src tests/xblox/modbus-server.xblox",
  "roots": [
    {
      "kind": "modbusServer",
      "id": "sample-server",
      "url": "tcp:127.0.0.1:15020",
      "unitId": 1,
      "holdingRegisters": [11, 22, 33],
      "registerCount": 16,
      "maxRequests": 3,
      "durationMs": 30000,
      "storeAs": "serverStats"
    },
    { "kind": "log", "level": "info", "message": "serverStats" }
  ]
}
