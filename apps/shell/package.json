{
  "name": "@polymech/shell",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pty": "concurrently \"npm run server\" \"vite\"",
    "dev:demo": "vite --open /chat/demo",
    "dev:embed": "webpack serve --config webpack.config.cjs --mode development",
    "build": "tsc --noEmit && vite build",
    "build:embed": "webpack --config webpack.config.cjs --mode production",
    "build:all": "npm run build && npm run build:embed",
    "build:analyze": "tsc --noEmit && vite build && start dist/stats.html",
    "preview": "vite preview",
    "serve": "npx serve dist -s",
    "server": "node server/pty-server.cjs",
    "server:debug": "set DEBUG=1&& node server/pty-server.cjs"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.114.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.544.0",
    "marked": "^15.0.6",
    "preact": "^10.29.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.2",
    "xterm": "^5.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "esbuild": "^0.27.7",
    "esbuild-loader": "^4.4.3",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.4",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "style-loader": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "ws": "^8.20.1"
  }
}
