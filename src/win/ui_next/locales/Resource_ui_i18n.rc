        MENUITEM "&Nœuds",              IDC_CMD_VIEW_NODES
#endif
    END
#if FEATURE_PIXLWIZ_AUTH || FEATURE_PIXLWIZ_SHARE
    POPUP "&Pixlwiz"
    BEGIN
#if FEATURE_PIXLWIZ_AUTH
        MENUITEM "&Connexion…",            IDM_PIXLWIZ_LOGIN
