        BEGIN
            MENUITEM "(aucun)", IDM_RECENT_MENU_DUMMY_FOLDER, GRAYED INACTIVE
        END
        MENUITEM "&Enregistrer le recadrage\tCtrl+S",       IDM_FILE_SAVE
