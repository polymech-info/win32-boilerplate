; ============================================================================
; PolyMech media-img — NSIS installer
; ============================================================================
; From packages/media/cpp:
;   npm run build:installer
; Output: dist\pm-images-setup.exe
; Requires: NSIS 3+, CMake release build (dist\win-x64\pm-image.exe + runtime DLLs)
; Optional: dist\installer\redist\VC_redist.x64.exe (see dist\installer\redist\README.txt, scripts\fetch-vc-redist.ps1)
; ============================================================================

!include "MUI2.nsh"
!include "FileFunc.nsh"
!include "WinMessages.nsh"
!include "nsDialogs.nsh"
!include "branding.nsh"

; Branding assets moved with the packaged dist tree.
!ifdef MUI_ICON
	!undef MUI_ICON
!endif
!ifdef MUI_UNICON
	!undef MUI_UNICON
!endif
!if /FileExists "dist\branding\pm_image.ico"
	!define MUI_ICON  "dist\branding\pm_image.ico"
	!define MUI_UNICON "dist\branding\pm_image.ico"
!endif

; ---------------------------------------------------------------------------
; Self-contained string helpers (PATH edit)
; ---------------------------------------------------------------------------

!macro _StrContainsConstructor un
	Function ${un}StrContains
		Exch $R1 ; SubString
		Exch 1
		Exch $R0 ; String
		Push $R2
		Push $R3
		Push $R4
		StrLen $R2 $R0
		StrLen $R3 $R1
		StrCpy $R4 0
		loop:
		IntCmp $R4 $R2 notfound 0 notfound
		StrCpy $R5 $R0 $R3 $R4
		StrCmp $R5 $R1 found
		IntOp $R4 $R4 + 1
		Goto loop
		found:
		StrCpy $R0 $R1
		Goto done
		notfound:
		StrCpy $R0 ""
		done:
		Pop $R4
		Pop $R3
		Pop $R2
		Pop $R1
		Exch $R0
	FunctionEnd
!macroend

!insertmacro _StrContainsConstructor ""

!macro StrContains ResultVar String SubString
	Push `${String}`
	Push `${SubString}`
	Call StrContains
	Pop `${ResultVar}`
!macroend

!macro _StrReplaceConstructor un
	Function ${un}StrReplace
		Exch $R2 ; New
		Exch 1
		Exch $R1 ; Old
		Exch 2
		Exch $R0 ; String
		Push $R3
		Push $R4
		Push $R5
		Push $R6
		Push $R7
		Push $R8
		Push $R9
		StrCpy $R3 0
		StrLen $R4 $R1
		StrLen $R6 $R0
		StrLen $R9 $R2
		loop:
		StrCpy $R5 $R0 $R4 $R3
		StrCmp $R5 $R1 found
		StrCmp $R3 $R6 done
		IntOp $R3 $R3 + 1
		Goto loop
		found:
		StrCpy $R5 $R0 $R3
		IntOp $R8 $R3 + $R4
		StrCpy $R7 $R0 "" $R8
		StrCpy $R0 "$R5$R2$R7"
		StrLen $R6 $R0
		IntOp $R3 $R3 + $R9
		Goto loop
		done:
		Pop $R9
		Pop $R8
		Pop $R7
		Pop $R6
		Pop $R5
		Pop $R4
		Pop $R3
		Push $R0
		Exch 3
		Pop $R1
		Pop $R0
		Pop $R2
	FunctionEnd
!macroend

!insertmacro _StrReplaceConstructor "un."

!macro StrReplace ResultVar String Old New
	Push `${String}`
	Push `${Old}`
	Push `${New}`
	!ifdef __UNINSTALL__
		Call un.StrReplace
	!else
		Call StrReplace
	!endif
	Pop `${ResultVar}`
!macroend

; ---------------------------------------------------------------------------
; Identity (MUI, ARP) — from cmake/Branding.cmake; regenerate: node scripts/refresh-installer-branding.mjs
; ---------------------------------------------------------------------------
Name        "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile     "dist\pm-images-setup.exe"
InstallDir  ""
RequestExecutionLevel user

Var IsAdmin
Var AddToPathCheckbox
Var AddToPathState

; ---------------------------------------------------------------------------
; Branding bitmaps — generated by: node scripts/make-installer-bitmaps.mjs
;   dist\installer\welcome.bmp   164×314  left panel on Welcome / Finish pages
;   dist\installer\header.bmp    150×57   top-right strip on every inner page
; ---------------------------------------------------------------------------
!if /FileExists "dist\installer\welcome.bmp"
	!define MUI_WELCOMEFINISHPAGE_BITMAP         "dist\installer\welcome.bmp"
	!define MUI_WELCOMEFINISHPAGE_BITMAP_NOSTRETCH
!endif
!if /FileExists "dist\installer\header.bmp"
	!define MUI_HEADERIMAGE
	!define MUI_HEADERIMAGE_BITMAP               "dist\installer\header.bmp"
	!define MUI_HEADERIMAGE_RIGHT
!endif

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
Page custom PathPage PathPageLeave
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; EU official languages (all present in NSIS 3+) ——————————————————————————
!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "German"
!insertmacro MUI_LANGUAGE "French"
!insertmacro MUI_LANGUAGE "Spanish"
!insertmacro MUI_LANGUAGE "SpanishInternational"
!insertmacro MUI_LANGUAGE "Italian"
!insertmacro MUI_LANGUAGE "Portuguese"
!insertmacro MUI_LANGUAGE "PortugueseBR"
!insertmacro MUI_LANGUAGE "Dutch"
!insertmacro MUI_LANGUAGE "Polish"
!insertmacro MUI_LANGUAGE "Czech"
!insertmacro MUI_LANGUAGE "Slovak"
!insertmacro MUI_LANGUAGE "Hungarian"
!insertmacro MUI_LANGUAGE "Romanian"
!insertmacro MUI_LANGUAGE "Bulgarian"
!insertmacro MUI_LANGUAGE "Greek"
!insertmacro MUI_LANGUAGE "Swedish"
!insertmacro MUI_LANGUAGE "Danish"
!insertmacro MUI_LANGUAGE "Finnish"
!insertmacro MUI_LANGUAGE "Estonian"
!insertmacro MUI_LANGUAGE "Latvian"
!insertmacro MUI_LANGUAGE "Lithuanian"
!insertmacro MUI_LANGUAGE "Slovenian"
!insertmacro MUI_LANGUAGE "Croatian"
!insertmacro MUI_LANGUAGE "Irish"
!insertmacro MUI_LANGUAGE "Luxembourgish"
; EEA / regional co-official ————————————————————————————————————————————————
!insertmacro MUI_LANGUAGE "Norwegian"
!insertmacro MUI_LANGUAGE "NorwegianNynorsk"
!insertmacro MUI_LANGUAGE "Catalan"
!insertmacro MUI_LANGUAGE "Galician"
!insertmacro MUI_LANGUAGE "Basque"

!include "langstrings.nsh"

Function PathPage
	!insertmacro MUI_HEADER_TEXT "$(PATH_OPT_TITLE)" "$(PATH_OPT_SUBTITLE)"
	nsDialogs::Create 1018
	Pop $0
	IfErrors page_abort

	${NSD_CreateCheckbox} 0 0u 100% 12u "$(PATH_OPT_CHECK)"
	Pop $AddToPathCheckbox
	${NSD_SetState} $AddToPathCheckbox ${BST_CHECKED}

	${NSD_CreateLabel} 16 16u 95% 32u "$(PATH_OPT_DESC)"
	Pop $0

	nsDialogs::Show
	page_abort:
FunctionEnd

Function PathPageLeave
	${NSD_GetState} $AddToPathCheckbox $AddToPathState
FunctionEnd

Function .onInit
	UserInfo::GetAccountType
	Pop $0
	StrCmp $0 "Admin" 0 not_admin
		StrCpy $IsAdmin "1"
		StrCpy $INSTDIR "$PROGRAMFILES\${PRODUCT_NAME}"
		Goto init_done
	not_admin:
		StrCpy $IsAdmin "0"
		StrCpy $INSTDIR "$LOCALAPPDATA\${PRODUCT_NAME}"
	init_done:
FunctionEnd

Section "Install"
	; Microsoft VC++ 2015-2022 x64 — embed if present at compile (npm run build:installer runs fetch-vc-redist.ps1)
	SetOutPath $PLUGINSDIR
	File /nonfatal "dist\installer\redist\VC_redist.x64.exe"
	IfFileExists "$PLUGINSDIR\VC_redist.x64.exe" 0 after_vcredist
		DetailPrint "Running Visual C++ 2015-2022 Redistributable (x64) (quiet)..."
		ExecWait '"$PLUGINSDIR\VC_redist.x64.exe" /install /quiet /norestart' $0
		StrCmp $0 0 vcredist_ok
		StrCmp $0 1638 vcredist_ok
		StrCmp $0 3010 vcredist_ok
		DetailPrint "Note: vc_redist.x64 returned exit $0 (0/1638/3010 = typically OK; see Microsoft docs)"
		vcredist_ok:
	after_vcredist:

	SetOutPath "$INSTDIR"

	; Native runtime: exe, shell DLLs, libvips/MSVC DLLs, sparse manifest, and pmi.cmd.
	SetOutPath "$INSTDIR\win-x64"
	File "dist\win-x64\${PRODUCT_EXE}"
	File /nonfatal "dist\win-x64\pm-viewer.exe"
	File /nonfatal "dist\win-x64\pm-image-cli.exe"
	File /nonfatal "dist\win-x64\pmi.cmd"
	File /nonfatal "dist\win-x64\${PM_IEXECUTE_DLL}"
	File /nonfatal "dist\win-x64\*.dll"
!if /FileExists "dist\win-x64\sparse\AppxManifest.xml"
	SetOutPath "$INSTDIR\win-x64\sparse"
	File /r "dist\win-x64\sparse\*.*"
!endif

	; Cross-platform shared runtime assets: WebView2 HTML bundles + packed icon assets.
	SetOutPath "$INSTDIR\shared"
	File /nonfatal "dist\shared\chat.html"
	File /nonfatal "dist\shared\viewer.html"
	File /nonfatal "dist\shared\viewer.*.js"
	File /nonfatal "dist\shared\viewer.*.wasm"
	File /nonfatal "dist\shared\settings.html"
	File /nonfatal "dist\shared\assets.pfs"
	File /nonfatal "dist\shared\*.txt"

	; Offline help: npm run docs:html (marked + GFM + highlight.js) before makensis
	SetOutPath "$INSTDIR\docs\html"
	File /r "dist\docs-html\*.*"

	; Default files for the live profile (%APPDATA%\…\pm-image): everything under dist\data.
	; Preserve existing user-edited profile files during updates.
	SetOutPath "$APPDATA\${PRODUCT_APPDATA_SUBDIR}"
	SetOverwrite off
	File /r "dist\data\*.*"
	SetOverwrite on

	SetOutPath "$INSTDIR"
	WriteUninstaller "$INSTDIR\Uninstall.exe"

	; Same path zip users can run manually: pm-image register-startmenu.
	ExecWait '"$INSTDIR\win-x64\${PRODUCT_EXE}" register-startmenu --folder "${STARTMENU_FOLDER}" --install-root "$INSTDIR"' $0

	StrCmp $IsAdmin "1" 0 reg_user
		WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayName"     "${PRODUCT_NAME}"
		WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayVersion"  "${PRODUCT_VERSION}"
		WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "Publisher"        "${PRODUCT_PUBLISHER}"
		WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "URLInfoAbout"     "${PRODUCT_WEB_SITE}"
		WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "UninstallString"  "$INSTDIR\Uninstall.exe"
		WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "InstallLocation"  "$INSTDIR"
		WriteRegDWORD HKLM "${PRODUCT_UNINST_KEY}" "NoModify" 1
		WriteRegDWORD HKLM "${PRODUCT_UNINST_KEY}" "NoRepair" 1
		${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
		IntFmt $0 "0x%08X" $0
		WriteRegDWORD HKLM "${PRODUCT_UNINST_KEY}" "EstimatedSize" $0
		WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "InstallMode" "AllUsers"
		Goto reg_done
	reg_user:
		WriteRegStr HKCU "${PRODUCT_UNINST_KEY}" "DisplayName"     "${PRODUCT_NAME}"
		WriteRegStr HKCU "${PRODUCT_UNINST_KEY}" "DisplayVersion"  "${PRODUCT_VERSION}"
		WriteRegStr HKCU "${PRODUCT_UNINST_KEY}" "Publisher"        "${PRODUCT_PUBLISHER}"
		WriteRegStr HKCU "${PRODUCT_UNINST_KEY}" "URLInfoAbout"     "${PRODUCT_WEB_SITE}"
		WriteRegStr HKCU "${PRODUCT_UNINST_KEY}" "UninstallString"  "$INSTDIR\Uninstall.exe"
		WriteRegStr HKCU "${PRODUCT_UNINST_KEY}" "InstallLocation"  "$INSTDIR"
		WriteRegDWORD HKCU "${PRODUCT_UNINST_KEY}" "NoModify" 1
		WriteRegDWORD HKCU "${PRODUCT_UNINST_KEY}" "NoRepair" 1
		${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
		IntFmt $0 "0x%08X" $0
		WriteRegDWORD HKCU "${PRODUCT_UNINST_KEY}" "EstimatedSize" $0
		WriteRegStr HKCU "${PRODUCT_UNINST_KEY}" "InstallMode" "CurrentUser"
	reg_done:

	IntCmp $AddToPathState ${BST_CHECKED} 0 skip_add_path skip_add_path
		Call AddToPath
	skip_add_path:

	DetailPrint "Registering Explorer (context menus, IExecute, Open With): register-explorer"
	ExecWait '"$INSTDIR\win-x64\${PRODUCT_EXE}" register-explorer' $0
SectionEnd

Section "Uninstall"
	DetailPrint "Removing Explorer registration (IExecute, context menus, Open With)..."
	IfFileExists "$INSTDIR\win-x64\${PRODUCT_EXE}" 0 skip_unreg_explorer
		ExecWait '"$INSTDIR\win-x64\${PRODUCT_EXE}" register-explorer --unregister --no-refresh-shell' $0
	skip_unreg_explorer:

	DetailPrint "Removing Start Menu shortcuts..."
	IfFileExists "$INSTDIR\win-x64\${PRODUCT_EXE}" 0 skip_unreg_startmenu
		ExecWait '"$INSTDIR\win-x64\${PRODUCT_EXE}" register-startmenu --unregister --folder "${STARTMENU_FOLDER}" --install-root "$INSTDIR"' $0
	skip_unreg_startmenu:

	Delete "$INSTDIR\win-x64\${PRODUCT_EXE}"
	Delete "$INSTDIR\win-x64\pm-viewer.exe"
	Delete "$INSTDIR\win-x64\pm-image-cli.exe"
	Delete "$INSTDIR\win-x64\pmi.cmd"
	Delete "$INSTDIR\win-x64\*.dll"
	Delete "$INSTDIR\win-x64\*.log"
	RMDir /r "$INSTDIR\win-x64\sparse"
	RMDir  "$INSTDIR\win-x64"
	RMDir /r "$INSTDIR\shared"
	RMDir /r "$INSTDIR\vendor"
	; Legacy flat-layout cleanup from older installers.
	Delete "$INSTDIR\${PRODUCT_EXE}"
	Delete "$INSTDIR\pm-viewer.exe"
	Delete "$INSTDIR\pm-image-cli.exe"
	Delete "$INSTDIR\pmi.cmd"
	Delete "$INSTDIR\assets.pfs"
	Delete "$INSTDIR\chat.html"
	Delete "$INSTDIR\viewer.html"
	Delete "$INSTDIR\settings.html"
	Delete "$INSTDIR\*.dll"
	RMDir /r "$INSTDIR\tabler-icons"
	RMDir /r "$INSTDIR\vips-modules-8.18"
	RMDir /r "$INSTDIR\scripts"
	RMDir /r "$INSTDIR\docs\html"
	RMDir  "$INSTDIR\docs"
	; Keep Roaming profile data: settings, templates, mcp.json, logs, web storage, sessions, etc.
	Delete "$INSTDIR\Uninstall.exe"
	RMDir  "$INSTDIR"

	Delete  "$SMPROGRAMS\${STARTMENU_FOLDER}\${PM_BRAND_APP_DISPLAY}.lnk"
	Delete  "$SMPROGRAMS\${STARTMENU_FOLDER}\Overview.lnk"
	Delete  "$SMPROGRAMS\${STARTMENU_FOLDER}\Help.lnk"
	Delete  "$SMPROGRAMS\${STARTMENU_FOLDER}\Help Integration.lnk"
	Delete  "$SMPROGRAMS\${STARTMENU_FOLDER}\Uninstall.lnk"
	RMDir   "$SMPROGRAMS\${STARTMENU_FOLDER}"
	; Legacy: "PolyMech Image Resizer" or PRODUCT_NAME as the Start Menu folder
	Delete  "$SMPROGRAMS\PolyMech Image Resizer\PM-Image.lnk"
	Delete  "$SMPROGRAMS\PolyMech Image Resizer\Uninstall.lnk"
	Delete  "$SMPROGRAMS\PolyMech Image Resizer\PolyMech Image Resizer.lnk"
	RMDir   "$SMPROGRAMS\PolyMech Image Resizer"
	; In case a build used a long name as the folder
	Delete  "$SMPROGRAMS\${PRODUCT_NAME}\${PRODUCT_NAME}.lnk"
	Delete  "$SMPROGRAMS\${PRODUCT_NAME}\Uninstall.lnk"
	RMDir   "$SMPROGRAMS\${PRODUCT_NAME}"

	ReadRegStr $0 HKLM "${PRODUCT_UNINST_KEY}" "InstallMode"
	StrCmp $0 "AllUsers" 0 unreg_user
		DeleteRegKey HKLM "${PRODUCT_UNINST_KEY}"
		Goto unreg_done
	unreg_user:
		DeleteRegKey HKCU "${PRODUCT_UNINST_KEY}"
	unreg_done:

	Call un.RemoveFromPath
SectionEnd

Function AddToPath
	StrCmp $IsAdmin "1" path_sys path_usr
	path_sys:
		ReadRegStr $0 HKLM "SYSTEM\CurrentControlSet\Control\Session Manager\Environment" "Path"
		!insertmacro StrContains $1 "$0" "$INSTDIR\win-x64"
		StrCmp $1 "" 0 already_in_path
		StrCpy $0 "$0;$INSTDIR\win-x64"
		WriteRegExpandStr HKLM "SYSTEM\CurrentControlSet\Control\Session Manager\Environment" "Path" "$0"
		Goto broadcast_path
	path_usr:
		ReadRegStr $0 HKCU "${ENV_KEY}" "Path"
		!insertmacro StrContains $1 "$0" "$INSTDIR\win-x64"
		StrCmp $1 "" 0 already_in_path
		StrCpy $0 "$0;$INSTDIR\win-x64"
		WriteRegExpandStr HKCU "${ENV_KEY}" "Path" "$0"
	broadcast_path:
		SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000
	already_in_path:
FunctionEnd

Function un.RemoveFromPath
	; Try system PATH (admin install) first. Also clean legacy flat $INSTDIR PATH entries.
	ReadRegStr $0 HKLM "SYSTEM\CurrentControlSet\Control\Session Manager\Environment" "Path"
	StrCpy $1 "$0"
	!insertmacro StrReplace $1 "$1" ";$INSTDIR\win-x64" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR\win-x64;" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR\win-x64" ""
	!insertmacro StrReplace $1 "$1" ";$INSTDIR" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR;" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR" ""
	StrCmp $1 "$0" try_usr_path write_sys_path
	write_sys_path:
	WriteRegExpandStr HKLM "SYSTEM\CurrentControlSet\Control\Session Manager\Environment" "Path" "$1"
	SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000
	Goto done_path

	; Try user PATH (non-admin install)
	try_usr_path:
	ReadRegStr $0 HKCU "${ENV_KEY}" "Path"
	StrCpy $1 "$0"
	!insertmacro StrReplace $1 "$1" ";$INSTDIR\win-x64" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR\win-x64;" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR\win-x64" ""
	!insertmacro StrReplace $1 "$1" ";$INSTDIR" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR;" ""
	!insertmacro StrReplace $1 "$1" "$INSTDIR" ""
	StrCmp $1 "$0" done_path write_usr_path
	write_usr_path:
	WriteRegExpandStr HKCU "${ENV_KEY}" "Path" "$1"
	SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000
	done_path:
FunctionEnd
