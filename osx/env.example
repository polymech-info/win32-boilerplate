# Copy into Windows User environment, or: setx PM_OSX_SSH osx
#     setx PM_OSX_CPP_ROOT "Z:/full/path"   (or use the lines below in PowerShell $env:... per session)
#
# ssh(1) destination: Host block from %USERPROFILE%\.ssh\config, or user@ip, or "local" to never ssh.
# On a Mac, npm scripts skip ssh by default (see scripts/run-ssh.cjs). Use PM_OSX_FORCE_SSH=1 to ssh from Mac.
PM_OSX_SSH=osx

# Path to packages/media/cpp ON THE MAC (guest). For reliable builds, use a LOCAL path
# (git clone under $HOME), not VMware HGFS — see osx/README.md Troubleshooting.
# Example after: git clone ... ~/polymech-mono
PM_OSX_CPP_ROOT=/Users/mc007/polymech-mono/packages/media/cpp

# macOS: add built CLI to your shell PATH (~/.zshrc or ~/.bash_profile).
# After PM_OSX_CPP_ROOT is set (above), use:
#   export PATH="$PM_OSX_CPP_ROOT/dist-osx:$PATH"
# Or a fixed path to this clone (no env var):
#   export PATH="/Users/mc007/polymech-mono/packages/media/cpp/dist-osx:$PATH"
