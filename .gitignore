# Silent install smoke test (npm run test:installer)
dist-installer-test/
# Generated offline docs (npm run docs:html); leave dist/ for CMake outputs
#dist/docs-html/
./android

# Machine-specific auto-generated file (FEATURE_CHAT_WEB=ON writes this to
# build/release/ChatWebResource.rc with an absolute path; the source-tree
# copy is a stale artifact — cmake never reads it, only the build-dir one).
src/win/ui_next/ChatWebResource.rc

# Sample license issuer runtime state
apps/license-server/data/
/license-test.json
build-cursor/

# Official Microsoft VC++ redistributable (see scripts/fetch-vc-redist.ps1)
dist/installer/redist/VC_redist.x64.exe

# Dev self-signed PFX + local password (npm run build:sign) — do not commit
dist/certs/*.pfx
dist/certs/.pm-codesign-pfx.password

# npm run log:pm-image:osx-last / log:pm-image:stream-tee
osx-last.txt
pm-image-oslog.txt

*.mp4

# Polymech/cached PAT (polymech-gitea-remote-pat.inc.sh; cwd-relative default name)
**/git-token
tests/run-tool
test/