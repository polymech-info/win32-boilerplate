[chat] Tool call: write_file args={"content":"#!/usr/bin/env node\nimport * as fs from 'fs';\nimport * as path from 'path';\nimport yargs from 'yargs';\nimport { hideBin } from 'yargs/helpers';\n\ninterface Arguments {\n  folderPath: string;\n}\n\nfunction calculateFolderSize(folderPath: string): number {\n  let totalSize = 0;\n\n  function traverse(currentPath: string): void {\n    try {\n      const stats = fs.statSync(currentPath);\n\n      if (stats.isFile()) {\n        totalSize += stats.size;\n      } else if (stats.isDirectory()) {\n        const entries = fs.readdirSync(currentPath);\n        for (const entry of entries) {\n          traverse(path.join(currentPath, entry));\n        }\n      }\n    } catch (error) {\n      // Silently skip files/folders that can't be accessed\n    }\n  }\n\n  traverse(folderPath);\n  return totalSize;\n}\n\nconst argv = yargs(hideBin(process.argv))\n  .command('$0 <folderPath>', 'Calculate folder size recursively', (commandYargs) => {\n    return commandYargs.positional('folderPath', {\n      describe: 'Path to the folder',\n      type: 'string',\n      demandOption: true\n    });\n  })\n  .help()\n  .strict()\n  .parseSync() as unknown as Arguments;\n\nconst size = calculateFolderSize(argv.folderPath);\nconsole.log(`FOLDER_SIZE_BYTES=${size}`);\n","options":{"append":false},"path":"C:\\Users\\zx\\Desktop\\polymech\\polymech-mono\\packages\\media\\cpp\\tests\\run-tool\\cli-app\\src\\index.ts"}
